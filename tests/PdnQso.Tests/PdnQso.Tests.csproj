<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reading a written frame log back in FrameLogWriterTests. xunit.v3, AwesomeAssertions
         and FakeTimeProvider come from tests/Directory.Build.props. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="M0LTE.Flex" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PdnQso.Link/PdnQso.Link.csproj" />
    <!-- The app, for the parts of it that are pure and worth pinning: the config and its
         validation, the command line, and the two line formatters the screen is made of.
         Referencing an Exe is fine - its entry point is not imported. -->
    <ProjectReference Include="../../src/PdnQso/PdnQso.csproj" />
  </ItemGroup>

</Project>
